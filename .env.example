# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# OpenAI (image generation via gpt-image-1)
OPENAI_API_KEY=

# Anthropic (Claude Haiku for image QA review)
ANTHROPIC_API_KEY=

# Playwright scraper — daily cap across all sessions (default 200)
SCRAPER_MAX_DAILY=200

# AWS S3 (image CDN)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-southeast-2

# Telegram (notifications to your bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SendGrid (inbound email parse webhook)
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_SECRET=
SENDGRID_INBOUND_DOMAIN=reply.youragency.com.au

# Instantly.ai (email sequences)
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
INSTANTLY_REFERRAL_CAMPAIGN_ID=

# Proxy for Instaloader / Playwright (Brightdata residential)
BRIGHTDATA_PROXY_URL=

# App
NEXT_PUBLIC_APP_URL=https://youragency.com.au
NEXT_PUBLIC_AGENCY_NAME=Mike's Social
NEXT_PUBLIC_AGENCY_EMAIL=mike@youragency.com.au
CRON_SECRET=
REVIEW_PASSWORD=

# Railway pipeline service URL (server-side only — never exposed to the browser)
PIPELINE_SERVICE_URL=https://your-service.railway.app
